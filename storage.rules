rules_version = '2';

// Two public paths, both written only by editors:
//   published/site.json  — the content snapshot visitors fetch
//   media/**             — images an editor uploaded
//
// Visitors read these over plain HTTPS with no SDK and no auth, which is what
// keeps the Firebase SDK out of the public bundle.
service firebase.storage {
  match /b/{bucket}/o {

    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }

    match /published/{file} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /media/{allPaths=**} {
      allow read: if true;
      // 10MB ceiling, images only — an editor picking a RAW file should fail
      // here rather than silently bloating the site.
      allow write: if isEditor()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isEditor();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
