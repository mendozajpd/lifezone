# Copy to .env and fill in once a real Firebase project exists.
# Not needed for everyday frontend dev (`docker compose up app`).

# Legacy CI token from `firebase login:ci` — simplest option for `firebase deploy`.
FIREBASE_TOKEN=

# Overrides the project id from .firebaserc for this run.
FIREBASE_PROJECT_ID=nltac-lifezone

# Path INSIDE the firebase container. Drop the real key file at ./secrets/firebase-service-account.json
# on the host (that directory is bind-mounted read-only into the container) and leave this pointing at it.
GOOGLE_APPLICATION_CREDENTIALS=/firebase/secrets/firebase-service-account.json

# Contact form Cloud Function. This is a public URL, not a secret — safe to expose in the client
# bundle (EXPO_PUBLIC_ vars are baked into the build). The Gmail credentials that actually send the
# email live server-side only: functions/.env (GMAIL_USER/CONTACT_EMAIL, non-secret) and the
# GMAIL_APP_PASSWORD Firebase secret (`firebase functions:secrets:set GMAIL_APP_PASSWORD`) — neither
# of those is ever read by the Expo app or shipped to the browser.
EXPO_PUBLIC_CONTACT_FUNCTION_URL=https://asia-southeast1-nltac-lifezone.cloudfunctions.net/sendContactMessage

# --- Site editor (/admin) ------------------------------------------------------
# Firebase web config. These identify the project to Google's endpoints and ship in
# every Firebase web app — they are NOT secrets. Access control is enforced by
# firestore.rules plus the admins/{email} allowlist, not by hiding these values.
# Copy them from Firebase console → Project settings → Your apps → Web app.
# Only the /admin routes load Firebase; visitors to the public site never do.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=nltac-lifezone
# Derived from the project id when omitted:
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=nltac-lifezone.firebaseapp.com
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=nltac-lifezone.firebasestorage.app

# Set to 1 to point /admin at the local emulators (`docker compose up firebase`).
# With this on, the API key and app id above are not needed — the emulators accept
# any value — and the Google popup is the emulator's test account picker.
EXPO_PUBLIC_USE_EMULATORS=
# Host-side emulator ports. Firestore is published on 8082, not its default 8080,
# to avoid clashing with other local services (see docker-compose.yml).
# EXPO_PUBLIC_EMULATOR_HOST=localhost
# EXPO_PUBLIC_EMULATOR_AUTH_PORT=9099
# EXPO_PUBLIC_EMULATOR_FIRESTORE_PORT=8082
