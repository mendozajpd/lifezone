# Copy to .env and fill in once a real Firebase project exists.
# Not needed for everyday frontend dev (`docker compose up app`).

# Legacy CI token from `firebase login:ci` — simplest option for `firebase deploy`.
FIREBASE_TOKEN=

# Overrides the project id from .firebaserc for this run.
FIREBASE_PROJECT_ID=nltac-lifezone

# Path INSIDE the firebase container. Drop the real key file at ./secrets/firebase-service-account.json
# on the host (that directory is bind-mounted read-only into the container) and leave this pointing at it.
GOOGLE_APPLICATION_CREDENTIALS=/firebase/secrets/firebase-service-account.json

# Contact form Cloud Function. This is a public URL, not a secret — safe to expose in the client
# bundle (EXPO_PUBLIC_ vars are baked into the build). The Gmail credentials that actually send the
# email live server-side only: functions/.env (GMAIL_USER/CONTACT_EMAIL, non-secret) and the
# GMAIL_APP_PASSWORD Firebase secret (`firebase functions:secrets:set GMAIL_APP_PASSWORD`) — neither
# of those is ever read by the Expo app or shipped to the browser.
EXPO_PUBLIC_CONTACT_FUNCTION_URL=https://asia-southeast1-nltac-lifezone.cloudfunctions.net/sendContactMessage
